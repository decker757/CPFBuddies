{
  "CandidateSelection": {
    "$defs": {
      "Currency": {
        "description": "Currencies this system can parse.\n\nOnly XSGD is settleable \u2014 that is a track rule, enforced by the Verifier\nrather than by this enum. The others exist because a merchant can quote in\nthem, and we would rather reject that with a reason code than fail to parse\nthe payload at all.",
        "enum": [
          "XSGD",
          "SGD",
          "USD"
        ],
        "title": "Currency",
        "type": "string"
      },
      "Listing": {
        "additionalProperties": false,
        "properties": {
          "availability": {
            "enum": [
              "in_stock",
              "out_of_stock"
            ],
            "title": "Availability",
            "type": "string"
          },
          "description": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "price": {
            "$ref": "#/$defs/Money"
          },
          "seller_account_age_days": {
            "maximum": 36500,
            "minimum": 0,
            "title": "Seller Account Age Days",
            "type": "integer"
          },
          "seller_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Seller Id",
            "type": "string"
          },
          "seller_rating": {
            "anyOf": [
              {
                "maximum": 5,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Seller Rating"
          },
          "seller_rating_count": {
            "maximum": 1000000000,
            "minimum": 0,
            "title": "Seller Rating Count",
            "type": "integer"
          },
          "sku": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Sku",
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "sku",
          "title",
          "description",
          "price",
          "availability",
          "seller_id",
          "seller_account_age_days",
          "seller_rating_count"
        ],
        "title": "Listing",
        "type": "object"
      },
      "Merchant": {
        "additionalProperties": false,
        "properties": {
          "address": {
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "title": "Address",
            "type": "string"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "address",
          "name"
        ],
        "title": "Merchant",
        "type": "object"
      },
      "Money": {
        "additionalProperties": false,
        "description": "A non-negative amount in a known currency.\n\nEquality and ordering compare exact minor units. Comparing across\ncurrencies raises: the Verifier rejects a currency mismatch with a reason\ncode before any comparison happens, so reaching that raise means a caller\nskipped the pipeline.",
        "properties": {
          "amount": {
            "title": "Amount",
            "type": "string"
          },
          "currency": {
            "$ref": "#/$defs/Currency"
          }
        },
        "required": [
          "currency",
          "amount"
        ],
        "title": "Money",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "basket_hash": {
        "pattern": "^0x[0-9a-fA-F]{64}$",
        "title": "Basket Hash",
        "type": "string"
      },
      "expires_at": {
        "format": "date-time",
        "title": "Expires At",
        "type": "string"
      },
      "listing": {
        "$ref": "#/$defs/Listing"
      },
      "merchant": {
        "$ref": "#/$defs/Merchant"
      },
      "quote_id": {
        "maxLength": 128,
        "minLength": 1,
        "title": "Quote Id",
        "type": "string"
      }
    },
    "required": [
      "quote_id",
      "expires_at",
      "merchant",
      "listing",
      "basket_hash"
    ],
    "title": "CandidateSelection",
    "type": "object"
  },
  "EvaluatorOutput": {
    "$defs": {
      "RiskReason": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/$defs/RiskReasonCode"
          },
          "detail": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "code",
          "detail"
        ],
        "title": "RiskReason",
        "type": "object"
      },
      "RiskReasonCode": {
        "enum": [
          "INTENT_MISMATCH",
          "PRICE_OVER_CAP",
          "PROMPT_INJECTION",
          "PRODUCT_SUBSTITUTION",
          "SUSPICIOUSLY_LOW_PRICE",
          "NEW_OR_UNRATED_SELLER",
          "EVALUATOR_UNAVAILABLE"
        ],
        "title": "RiskReasonCode",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "evaluator_id": {
        "default": "evaluator-v1",
        "maxLength": 128,
        "minLength": 1,
        "title": "Evaluator Id",
        "type": "string"
      },
      "injection_detected": {
        "title": "Injection Detected",
        "type": "boolean"
      },
      "intent_match": {
        "title": "Intent Match",
        "type": "boolean"
      },
      "price_within_cap": {
        "title": "Price Within Cap",
        "type": "boolean"
      },
      "reasons": {
        "items": {
          "$ref": "#/$defs/RiskReason"
        },
        "maxItems": 10,
        "title": "Reasons",
        "type": "array"
      },
      "risk_score": {
        "maximum": 10,
        "minimum": 1,
        "title": "Risk Score",
        "type": "integer"
      }
    },
    "required": [
      "risk_score",
      "intent_match",
      "price_within_cap",
      "injection_detected",
      "reasons"
    ],
    "title": "EvaluatorOutput",
    "type": "object"
  },
