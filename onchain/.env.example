# Copy to .env and fill in. Never commit .env.

# Deployer key. TESTNET ONLY -- production signing goes through KMS in the settlement worker.
DEPLOYER_PRIVATE_KEY=

# Settlement token. Leave UNSET on local and Fuji to deploy MockXSGD instead.
# On mainnet, set this to the real XSGD address on Avalanche C-Chain.
XSGD_ADDRESS=
MOCK_XSGD_DECIMALS=6

# Role holders. Default to the deployer when unset.
# In a real deployment these differ: Mandate Service registers, Settlement Worker spends.
REGISTRAR_ADDRESS=
SETTLER_ADDRESS=

# RPC overrides. Defaults are the public Avalanche endpoints.
FUJI_RPC_URL=
AVALANCHE_RPC_URL=

# Snowtrace verification (optional)
SNOWTRACE_API_KEY=
