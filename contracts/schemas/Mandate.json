{
  "$defs": {
    "Currency": {
      "description": "Currencies this system can parse.\n\nOnly XSGD is settleable — that is a track rule, enforced by the Verifier\nrather than by this enum. The others exist because a merchant can quote in\nthem, and we would rather reject that with a reason code than fail to parse\nthe payload at all.",
      "enum": [
        "XSGD",
        "SGD",
        "USD"
      ],
      "title": "Currency",
      "type": "string"
    },
    "Money": {
      "additionalProperties": false,
      "description": "A non-negative amount in a known currency.\n\nEquality and ordering compare exact minor units. Comparing across\ncurrencies raises: the Verifier rejects a currency mismatch with a reason\ncode before any comparison happens, so reaching that raise means a caller\nskipped the pipeline.",
      "properties": {
        "currency": {
          "$ref": "#/$defs/Currency"
        },
        "amount": {
          "title": "Amount",
          "type": "string"
        }
      },
      "required": [
        "currency",
        "amount"
      ],
      "title": "Money",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The struct that gets hashed and signed. Field order matches EIP-712.",
  "properties": {
    "mandate_id": {
      "pattern": "^0x[0-9a-fA-F]{64}$",
      "title": "Mandate Id",
      "type": "string"
    },
    "principal": {
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "title": "Principal",
      "type": "string"
    },
    "agent_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Agent Id",
      "type": "string"
    },
    "max_amount": {
      "$ref": "#/$defs/Money"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "intent": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Intent",
      "type": "string"
    },
    "merchant_address": {
      "anyOf": [
        {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Merchant Address"
    },
    "basket_hash": {
      "anyOf": [
        {
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Basket Hash"
    },
    "nonce": {
      "pattern": "^0x[0-9a-fA-F]{64}$",
      "title": "Nonce",
      "type": "string"
    }
  },
  "required": [
    "mandate_id",
    "principal",
    "agent_id",
    "max_amount",
    "expires_at",
    "intent",
    "nonce"
  ],
  "title": "Mandate",
  "type": "object"
}
