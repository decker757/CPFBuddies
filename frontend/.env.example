# Copy to .env.local and fill in. Vite loads .env.local automatically.
#
# EVERYTHING HERE IS PUBLIC. Vite inlines VITE_* variables into the built
# JavaScript and serves them to every browser that loads the page. Never put a
# private key, a token or a credential in this file.

# Where the rail is listening.
VITE_API_BASE=http://localhost:8000

# The buyer's ADDRESS -- never its key.
#
# spend() pulls XSGD from this wallet, so against a real chain it must hold the
# tokens and have approved the MandateRegistry (scripts/demo_onchain.py --fund
# does that). The built-in default is a placeholder that holds nothing: it works
# offline, and on mainnet it passes every offchain check and then reverts at the
# contract for want of a balance.
VITE_PRINCIPAL=
