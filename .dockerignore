# Keys first. `.env` files hold the registrar and settler private keys, and a
# COPY that swept one into a layer would publish it to every registry the image
# reaches — deleting it in a later layer would not help, the layer keeps it.
.env
.env.*
**/.env
**/.env.*
!**/.env.example

# Rebuilt inside the image, and copying them in would let a stale local build
# silently win over the one the Dockerfile compiles.
node_modules
**/node_modules
onchain/artifacts
onchain/cache
onchain/typechain-types

# Host virtualenv: wrong platform, wrong interpreter, and large.
.venv
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache

# Generated, and regenerated by a hook on every commit and checkout.
graphify-out

# Not served by the API container.
frontend/dist
frontend/node_modules

.git
.github
