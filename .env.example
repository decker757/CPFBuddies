# Copy to .env and fill in. Never commit .env.
#
# Read by `app.rail:demo_app` and `app.rail:chain_app` at startup, together with
# `backend/.env`. A variable already set in the shell always wins over both, so
# `$env:TRUSTRAIL_DEMO_SKU = "..."` overrides this file without editing it.
#
# These are private keys in a file, which is exactly what CLAUDE.md says must
# stop: "KMS for the issuer signing key AND the hot wallet key. No private key
# material anywhere else." Swapping LocalSigner for KmsSigner in `chain_app` is
# the whole change, and this file is the reason it matters.

# --- Chain ------------------------------------------------------------------

# Which deployment to settle against: `avalanche`, `localhost`, `hardhat`.
# Addresses come from onchain/deployments/<network>.json, never from here.
TRUSTRAIL_NETWORK=avalanche
TRUSTRAIL_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Holds REGISTRAR_ROLE: registers mandates onchain at mint. Needs AVAX for gas.
# Must be the address the deployment granted the role to, or `chain_app` refuses
# to start rather than reverting three steps later.
TRUSTRAIL_REGISTRAR_KEY=

# Holds SETTLER_ROLE: calls spend(). Needs AVAX for gas.
# Deliberately a different key from the registrar -- a compromised settlement
# worker must not be able to invent mandates of its own.
TRUSTRAIL_SETTLER_KEY=

# The buyer. This is the wallet XSGD is spent FROM, so it needs XSGD and a
# little AVAX.
#
# Only `scripts/demo_onchain.py` uses this key, and only to send the one-time
# `approve()` of the MandateRegistry. The server never needs it: spend() is the
# settler's transaction and pulls from this wallet's allowance, so after the
# approval the mandate bounds the spend rather than custody of a key.
#
# LEAVE IT BLANK to buy as `DEPLOYER_PRIVATE_KEY` from onchain/.env, which is
# where the XSGD actually sits on this deployment. The script says so loudly
# when it does. That beats copying one private key into a second file, which
# would be two places to rotate it and two chances to leak it -- but it is a
# demo convenience only: a real principal is a customer, and their wallet should
# not be reachable from ours.
#
# The frontend needs this wallet's ADDRESS, not its key -- set VITE_PRINCIPAL in
# frontend/.env.local. Never put a key in a VITE_ variable: Vite inlines those
# into the built JavaScript and serves them to the browser.
TRUSTRAIL_PRINCIPAL_KEY=

# --- Demo and runtime -------------------------------------------------------

# Pin the Browser Agent to one listing. Needed to reach the PASS beat at all:
# the agent picks by lowest price and the good S$4.20 toothbrush is undercut by
# both poisoned listings. TB-SOFT-2PK / TB-SUSPICIOUS / TB-INJECTION /
# GIFT-SUBSTITUTE. Leave unset for honest selection, which lands in REVIEW.
TRUSTRAIL_DEMO_SKU=

# `bedrock`, or `rules`/`none` to force the deterministic evaluator. Unset uses
# Bedrock when AWS_BEARER_TOKEN_BEDROCK is present (see backend/.env).
TRUSTRAIL_EVALUATOR_MODEL=

# Without this the app's own log lines are dropped: uvicorn configures its own
# loggers and leaves the root logger alone, so every verdict is emitted and
# never printed.
TRUSTRAIL_LOG_LEVEL=INFO

# Comma-separated origin allowlist for the frontend. Defaults to the Vite dev
# server. Set empty to allow nothing.
TRUSTRAIL_CORS_ORIGINS=
